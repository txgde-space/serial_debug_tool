*.dSYM/
*.xcarchive/
*.zip
*.dmg
*.pkg
/dist/

# Downloaded Windows installers and local development notes
/offline-installers/

# Local agent configuration and signing credentials
/.codex/
/.agents/
.env
.env.*
!.env.example
*.p12
*.p8
*.mobileprovision
*.provisionprofile
